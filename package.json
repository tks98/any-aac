{
  "name": "any-aac",
  "version": "0.1.0",
  "private": true,
  "description": "A free, open-source AAC (augmentative and alternative communication) app that runs in the browser and works offline.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @any-aac/web dev",
    "dev:lan": "pnpm --filter @any-aac/web dev --host",
    "build": "pnpm --filter @any-aac/web build",
    "preview": "pnpm --filter @any-aac/web preview",
    "preview:lan": "pnpm --filter @any-aac/web preview --host",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @any-aac/web test:e2e",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
